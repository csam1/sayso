{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the overlay, welcome and dashboard windows",
  "windows": [
    "overlay",
    "welcome",
    "dashboard"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "global-shortcut:default",
    "macos-permissions:default"
  ]
}
